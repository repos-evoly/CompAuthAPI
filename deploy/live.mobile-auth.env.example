SERVICE_TOKEN_ISSUER=company-gateway-service-auth-live
SERVICE_TOKEN_AUDIENCE=company-gateway-internal-apis-live
SERVICE_TOKEN_ENVIRONMENT=live
SERVICE_TOKEN_REQUIRED_SCOPE=company-gateway.mobile
SERVICE_TOKEN_LIFETIME_SECONDS=300
MOBILE_AUTH_CHALLENGE_LIFETIME_SECONDS=300

SERVICE_AUTH_CLIENT_ID=company-gateway-mobile-bff-live
SERVICE_AUTH_CLIENT_SECRET=__PROVIDE_FROM_SECRET_STORE__
SERVICE_AUTH_ALLOWED_SCOPES=company-gateway.mobile

# Supply PEM values from the server secret store. Literal \n sequences are accepted.
SERVICE_TOKEN_PRIVATE_KEY=__PROVIDE_RSA_PRIVATE_KEY_PEM_FROM_SECRET_STORE__
SERVICE_TOKEN_PUBLIC_KEY=__PROVIDE_RSA_PUBLIC_KEY_PEM_FROM_SECRET_STORE__
